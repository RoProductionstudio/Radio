<?xml version="1.0" encoding="utf-8"?>
<!-- Многие радиопотоки отдаются по http, поэтому разрешаем незашифрованный трафик. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
